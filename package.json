{
  "name": "forge-webmcp",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "packages/*",
    "forge-personal",
    "forge-enrich"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:personal": "npm run dev -w @forge/personal",
    "dev:enrich": "npm run dev -w @forge/enrich",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:run": "npm run test:run --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "verify:sources": "node scripts/verify-live-sources.mjs && node --experimental-strip-types scripts/regress-live-adapters.mjs",
    "migrate": "node scripts/migrate.mjs",
    "capture:sources": "node scripts/capture-live-projections.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  }
}
