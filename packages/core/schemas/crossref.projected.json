{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/crossref.projected.json",
  "type": "object",
  "required": ["DOI", "title"],
  "properties": {
    "DOI": { "type": "string", "minLength": 1 },
    "title": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "type": "string" } },
    "update-to": { "$ref": "#/$defs/integrityEvents" },
    "updated-by": { "$ref": "#/$defs/integrityEvents" }
  },
  "$defs": {
    "integrityEvents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "DOI", "updated"],
        "properties": {
          "type": { "type": "string" },
          "DOI": { "type": "string" },
          "source": { "type": "string" },
          "updated": {
            "type": "object",
            "required": ["date-time"],
            "properties": { "date-time": { "type": "string" } },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
