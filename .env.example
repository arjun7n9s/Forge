# forge-personal
NEXT_PUBLIC_ENRICH_ORIGIN=http://localhost:3001
# Chrome WebMCP origin trial token for this exact origin. Never commit the live value.
NEXT_PUBLIC_ORIGIN_TOKEN=

# forge-enrich
NEXT_PUBLIC_FORGE_ORIGIN=http://localhost:3000
NEXT_PUBLIC_ORIGIN_TOKEN=
CONTACT_EMAIL=forge@example.com
CROSSREF_MAILTO=forge@example.com

# Hosted persistence only; local build does not require it.
DATABASE_URL=
DATABASE_SSL=false
# SHA-256 hex of the user-entered workspace access key.
FORGE_ACCESS_KEY_SHA256=
# At least 32 random characters. Never expose this with NEXT_PUBLIC_.
FORGE_SESSION_SECRET=
